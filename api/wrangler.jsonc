{
  "name": "rumah-kemasan-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "FIREBASE_PROJECT_ID": "simkemas",
    "ALLOWED_ORIGINS": "http://localhost:5173,https://rumah-kemasan.diviabdillah94.workers.dev"
  },
  // Pembatas permintaan (per lokasi Cloudflare). period hanya boleh 10 atau 60 detik.
  "ratelimits": [
    { "name": "BATAS_IP", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "BATAS_BACA", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "BATAS_TULIS", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ]
}
